DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require

# Security
SECRET_KEY=your-super-secret-key-here
ENCRYPTION_KEY=your-32-character-encryption-key

# Environment
ENVIRONMENT=production
LOG_LEVEL=info

# CORS
BACKEND_CORS_ORIGINS=https://sqltuner-frontend-xxxxx.run.app
FRONTEND_URL=https://sqltuner-frontend-xxxxx.run.app/workspaces

# Cookie Security (HTTPS production)
COOKIE_SECURE=true
COOKIE_SAMESITE=None

# Optional: Google OAuth (nếu sử dụng)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret