# ============================================================
# Spider Evaluation — Cấu hình biến môi trường
# Sao chép file này thành .env rồi điền giá trị thực tế:
#   cp .env.example .env
# ============================================================

# ── Cấu hình chung ──────────────────────────────────────────

# (BẮT BUỘC) Đường dẫn tới thư mục Spider dataset
EVAL_SPIDER_DIR=/path/to/spider

# Chế độ đánh giá: "offline" (gọi LLM trực tiếp) | "api" (gọi server)
# Mặc định: offline
EVAL_MODE=offline

# Số lượng sample tối đa cần đánh giá
# Mặc định: 100
EVAL_LIMIT=100

# Chỉ đánh giá một database cụ thể (để trống = tất cả)
# Ví dụ: EVAL_DB_ID=concert_singer
EVAL_DB_ID=

# Đường dẫn file kết quả JSON đầu ra
# Mặc định: eval_results.json
EVAL_OUTPUT=eval_results.json


# ── Offline mode — Gọi LLM trực tiếp (không cần server) ────
# Dùng khi EVAL_MODE=offline

# Backend LLM: "ollama" | "groq"
# Mặc định: ollama
EVAL_LLM_BACKEND=ollama

# URL Ollama (chỉ dùng khi EVAL_LLM_BACKEND=ollama)
# Mặc định: http://localhost:11434
EVAL_LLM_URL=http://localhost:11434

# Tên model LLM
# Ví dụ Ollama: sqlcoder:7b, llama3, mistral
# Ví dụ Groq  : mixtral-8x7b-32768, llama3-70b-8192
EVAL_LLM_MODEL=sqlcoder:7b

# Groq API Key (chỉ cần khi EVAL_LLM_BACKEND=groq)
GROQ_API_KEY=


# ── API mode — Gọi hệ thống đang chạy (end-to-end) ─────────
# Dùng khi EVAL_MODE=api

# Base URL của backend
EVAL_API_URL=http://localhost:8000

# JWT token (lấy từ đăng nhập vào hệ thống)
EVAL_API_TOKEN=

# UUID của Connection bất kỳ trong hệ thống
EVAL_CONNECTION_ID=
