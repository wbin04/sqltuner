# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=SQLTuner

# CORS Origins (comma-separated list)
BACKEND_CORS_ORIGINS=http://localhost:5173

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=sqltuner
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5433/sqltuner_db

# Enable database
ENABLE_DATABASE=true

# Row limits to prevent UI freeze with large result sets
SANDBOX_MAX_ROWS=10000
RESULT_MAX_ROWS=100

# Ollama LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=sqlcoder-thesis
MODEL_CHAT_NAME=qwen2.5:3b

# Encryption key for database passwords (keep secret!)
ENCRYPTION_KEY=ENCRYPTION_KEY

# JWT Settings
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
